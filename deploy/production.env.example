# Application environment for `deploy/compose.yml`.
# Copy to `deploy/production.env`; it is gitignored. The database password in
# DATABASE_URL must match POSTGRES_PASSWORD in `deploy/.env`.
#
# Generate APP_SECRET with: openssl rand -hex 32
APP_ENV=production
APP_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
LOG_LEVEL=info

DATABASE_URL=postgresql+asyncpg://nero:replace-with-the-same-password@db:5432/nero

FRONTEND_ORIGIN=https://app.example.com
SESSION_COOKIE_NAME=nero_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true

RATE_LIMIT_BACKEND=postgres
MAX_REQUEST_BODY_BYTES=1048576

# Chat gateway. Leave both blank to keep the chat model out of the catalog.
# Set a spend cap on this key in the provider dashboard before going live.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=deepseek-v4.1-flash
AI_REQUEST_TIMEOUT_SECONDS=120

# Image/Video stay mock until a real provider key and adapter exist.
GENERATION_MODE=mock

# Local volume shared by the API, worker, and release job.
STORAGE_BACKEND=local
STORAGE_DIR=/app/storage
# Managed bucket alternative:
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=nero

WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_STALE_AFTER_SECONDS=300
HOLD_TTL_SECONDS=3600

# Plan changes are simulated; production must reject them.
ALLOW_SIMULATED_PLAN_CHANGES=false

OPS_QUEUE_BACKLOG_THRESHOLD=10
OPS_QUEUE_BACKLOG_AGE_SECONDS=300
OPS_PROVIDER_ERROR_THRESHOLD=10
OPS_PROVIDER_ERROR_WINDOW_SECONDS=900
OPS_ALERT_WEBHOOK_URL=
