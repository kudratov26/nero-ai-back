# Application
APP_ENV=development
APP_SECRET=change-me-in-production
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://nero:nero@localhost:5432/nero

# Browser integration
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=nero_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Model provider (Coarena gateway for DeepSeek V4.1 Flash)
# Confirm the base URL and exact model slug with the provider before Phase 3.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=deepseek-v4.1-flash
AI_REQUEST_TIMEOUT_SECONDS=120

# Generations: keep mock until a real image/video provider key exists
GENERATION_MODE=mock
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Plans are simulated in v1; disable in production
ALLOW_SIMULATED_PLAN_CHANGES=true

# Rate limiting: memory is fine for one instance
RATE_LIMIT_BACKEND=memory

# Optional observability
SENTRY_DSN=
