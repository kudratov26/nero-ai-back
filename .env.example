# Application
APP_ENV=development
APP_SECRET=change-me-in-production
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://nero:nero@localhost:5432/nero

# Browser integration
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=nero_session
SESSION_TTL_DAYS=30
# Local dev is http. Production requires true (or unset, which derives it).
COOKIE_SECURE=false

# Model provider (Coarena gateway for DeepSeek V4.1 Flash)
# Leave both blank to keep the chat model out of the catalog.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=deepseek-v4.1-flash
AI_REQUEST_TIMEOUT_SECONDS=120

# Generations: keep mock until a real image/video provider key exists
GENERATION_MODE=mock
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Generation worker (`python -m app.worker`)
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_STALE_AFTER_SECONDS=300

# A hold older than this is refunded by the worker's expired-hold sweeper
HOLD_TTL_SECONDS=3600

# Plans are simulated in v1; disable in production
ALLOW_SIMULATED_PLAN_CHANGES=true

# Rate limiting: postgres survives restarts and is shared by every process;
# memory is for tests or a throwaway single process. redis is rejected until implemented.
RATE_LIMIT_BACKEND=postgres

# Request bodies larger than this are rejected with 413
MAX_REQUEST_BODY_BYTES=1048576

# Operations (`python -m app.cli ops-check`). Alerts go to structured logs and,
# when this webhook is set, to that URL.
OPS_QUEUE_BACKLOG_THRESHOLD=10
OPS_QUEUE_BACKLOG_AGE_SECONDS=300
OPS_PROVIDER_ERROR_THRESHOLD=10
OPS_PROVIDER_ERROR_WINDOW_SECONDS=900
OPS_ALERT_WEBHOOK_URL=

# Reserved; error reporting is not wired yet
SENTRY_DSN=
